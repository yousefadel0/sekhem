+++ b/backend/src/agent-runtime/tools/tool-permission.service.ts
@@ -0,0 +1,24 @@
+import { Inject, Injectable } from "@nestjs/common";
+import { ResourceAuthorizationService, type AuthAction, type AuthSubject } from "../../auth/resource-authz.service";
+import type { PermissionDecision, ToolPermission, ToolScope, TrustedToolWorkspace } from "./tool-contract";
+
+const actions: Record<ToolPermission, AuthAction> = {
+  "filesystem.read": "READ", "filesystem.write": "UPDATE", "filesystem.delete": "DELETE", "terminal.execute": "EXECUTE",
+  "git.read": "READ", "git.write": "UPDATE", "package.install": "EXECUTE", "browser.open": "EXECUTE"
+};
+@Injectable()
+export class ToolPermissionService {
+  constructor(@Inject(ResourceAuthorizationService) private readonly resources: ResourceAuthorizationService) {}
+  async check(subject: AuthSubject, required: readonly ToolPermission[], workspace: TrustedToolWorkspace, scope: ToolScope, organizationId?: string): Promise<PermissionDecision[]> {
+    const result: PermissionDecision[] = [];
+    for (const permission of [...new Set(required)]) {
+      const granted = workspace.permissions.includes(permission);
+      // Base application permission is checked identically before/after approval.
+      const allowed = granted && await this.resources.authorize(subject, actions[permission], {
+        resourceType: "Project", id: workspace.projectId, projectId: workspace.projectId, organizationId
+      });
+      result.push({ permission, allowed, reason: !granted ? "WORKSPACE_GRANT_MISSING" : allowed ? "GRANTED" : "RESOURCE_PERMISSION_DENIED", scope });
+    }
+    return result;
+  }
+}
diff --git a/backend/src/agent-runtime/tools/tool-registry.service.ts b/backend/src/agent-runtime/tools/tool-registry.service.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/agent-runtime/tools/tool-registry.service.ts
@@ -0,0 +1,55 @@
+import { Injectable } from "@nestjs/common";
+import { TOOL_PERMISSIONS, boundedToolJson, validToolId, type AgentTool, type ToolJsonSchema, type ToolPermission, type ToolRisk } from "./tool-contract";
+
+const text = (maxLength = 1024): ToolJsonSchema => ({ type: "string", minLength: 1, maxLength });
+const object = (properties: Record<string, ToolJsonSchema>): ToolJsonSchema => ({ type: "object", properties, required: Object.keys(properties), additionalProperties: false });
+const list = (maxItems: number): ToolJsonSchema => ({ type: "array", items: text(), maxItems });
+const output = object({ status: { ...text(32), enum: ["NOT_EXECUTED"] } });
+const definitions = (): AgentTool[] => {
+  const tool = (id: string, riskLevel: ToolRisk, permissions: ToolPermission[], properties: Record<string, ToolJsonSchema>, pathFields: string[]): AgentTool => ({
+    id, version: "1.0.0", category: id.startsWith("filesystem.") ? "FILESYSTEM" : id.startsWith("git.") ? "GIT" : "TERMINAL",
+    description: `Propose ${id}; definition only, no execution implementation.`, inputSchema: object(properties), outputSchema: output,
+    requiredPermissions: permissions, riskLevel, executionMode: "DEFINITION_ONLY", supportsDryRun: false, reversible: false, pathFields
+  });
+  return [
+    ...["list", "read"].map(id => tool(`filesystem.${id}`, "LOW", ["filesystem.read"], { path: text() }, ["path"])),
+    tool("filesystem.search", "LOW", ["filesystem.read"], { path: text(), query: text(512) }, ["path"]),
+    tool("filesystem.write", "MEDIUM", ["filesystem.write"], { path: text(), content: { type: "string", maxLength: 16384 } }, ["path"]),
+    tool("filesystem.delete", "HIGH", ["filesystem.delete"], { path: text() }, ["path"]),
+    tool("filesystem.move", "MEDIUM", ["filesystem.read", "filesystem.write", "filesystem.delete"], { source: text(), destination: text() }, ["source", "destination"]),
+    tool("filesystem.copy", "MEDIUM", ["filesystem.read", "filesystem.write"], { source: text(), destination: text() }, ["source", "destination"]),
+    tool("terminal.execute", "HIGH", ["terminal.execute"], { cwd: text(), command: text(4096) }, ["cwd"]),
+    ...["status", "diff", "log"].map(id => tool(`git.${id}`, "LOW", ["git.read"], { cwd: text() }, ["cwd"])),
+    // Branch is explicitly inspection-only. Creating/switching a branch uses a future version.
+    tool("git.branch", "LOW", ["git.read"], { cwd: text() }, ["cwd"]),
+    tool("git.checkout", "MEDIUM", ["git.write"], { cwd: text(), ref: text(256) }, ["cwd"]),
+    tool("git.add", "MEDIUM", ["git.write"], { cwd: text(), paths: list(32) }, ["cwd", "paths"]),
+    tool("git.commit", "MEDIUM", ["git.write"], { cwd: text(), message: text(1024) }, ["cwd"]),
+    tool("git.push", "HIGH", ["git.write"], { cwd: text(), remote: text(128), ref: text(256) }, ["cwd"])
+  ];
+};
+function freeze<T>(v: T): T {
+  if (v && typeof v === "object") { Object.values(v).forEach(freeze); Object.freeze(v); }
+  return v;
+}
+@Injectable()
+export class ToolRegistryService {
+  private readonly tools = new Map<string, AgentTool>();
+  constructor() { definitions().forEach(tool => this.register(tool)); }
+  register(tool: AgentTool): void {
+    if (!boundedToolJson(tool) || !validToolId(tool.id) || !/^\d+\.\d+\.\d+$/.test(tool.version) || tool.executionMode !== "DEFINITION_ONLY" ||
+      !["LOW", "MEDIUM", "HIGH"].includes(tool.riskLevel) || !Array.isArray(tool.requiredPermissions) || !tool.requiredPermissions.length ||
+      tool.requiredPermissions.some(p => !TOOL_PERMISSIONS.includes(p)) || !Array.isArray(tool.pathFields) || !tool.pathFields.length ||
+      tool.pathFields.some(p => !tool.inputSchema.properties?.[p]) || "execute" in tool) throw new Error("INVALID_TOOL_DEFINITION");
+    if (this.tools.has(tool.id)) throw new Error("DUPLICATE_TOOL");
+    this.tools.set(tool.id, freeze(structuredClone(tool)));
+  }
+  has(id: string): boolean { return this.tools.has(id); }
+  get(id: string): AgentTool | undefined { return this.tools.get(id); }
+  list(): AgentTool[] { return [...this.tools.values()].sort((a, b) => a.id < b.id ? -1 : a.id > b.id ? 1 : 0); }
+  resolve(id: string, version?: string): AgentTool {
+    const tool = this.get(id);
+    if (!tool || (version !== undefined && version !== tool.version)) throw new Error("INVALID_TOOL");
+    return tool;
+  }
+}
diff --git a/backend/src/agent-runtime/tools/tool-risk.service.ts b/backend/src/agent-runtime/tools/tool-risk.service.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/agent-runtime/tools/tool-risk.service.ts
@@ -0,0 +1,13 @@
+import { Injectable } from "@nestjs/common";
+import type { AgentTool, ToolRisk } from "./tool-contract";
+
+@Injectable()
+export class ToolRiskService {
+  classify(tool: AgentTool): ToolRisk {
+    const high = ["filesystem.delete", "terminal.execute", "git.push", "package.install", "process.kill"];
+    const medium = ["filesystem.write", "filesystem.move", "filesystem.copy", "git.checkout", "git.add", "git.commit"];
