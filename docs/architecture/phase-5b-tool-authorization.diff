diff --git a/backend/src/agent-runtime/tools/agent-tool-control.service.ts b/backend/src/agent-runtime/tools/agent-tool-control.service.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/agent-runtime/tools/agent-tool-control.service.ts
@@ -0,0 +1,96 @@
+import { BadRequestException, Inject, Injectable, NotFoundException } from "@nestjs/common";
+import { PrismaService } from "../../data-access/prisma.service";
+import { ResourceAuthorizationService } from "../../auth/resource-authz.service";
+import { AuditService } from "../../audit/audit.service";
+import type { SessionClaims } from "../../auth/auth.dto";
+import { ToolAuthorizationService, blockedTool } from "./tool-authorization.service";
+import { ToolApprovalService } from "./tool-approval.service";
+import { boundedToolJson, isRecord, toolSubject, validToolId, type AgentDecision, type AuthorizationDecision, type TrustedToolWorkspace } from "./tool-contract";
+
+/** Durable control-plane seam; deliberately has no skill/executor dependency. */
+@Injectable()
+export class AgentToolControlService {
+  constructor(
+    @Inject(PrismaService) private readonly prisma: PrismaService,
+    @Inject(ResourceAuthorizationService) private readonly resources: ResourceAuthorizationService,
+    @Inject(AuditService) private readonly audit: AuditService,
+    @Inject(ToolAuthorizationService) private readonly authorization: ToolAuthorizationService,
+    @Inject(ToolApprovalService) private readonly approvals: ToolApprovalService
+  ) {}
+  async applyDecision(runId: string, claims: SessionClaims, value: unknown, workspace?: TrustedToolWorkspace) {
+    if (!boundedToolJson(value) || !isRecord(value) || !["EXECUTE_TOOL", "REQUEST_APPROVAL", "ASK_USER", "REPLAN", "VERIFY", "COMPLETE", "STOP"].includes(String(value.type)) ||
+      Object.keys(value).some(k => !["type", "toolRequest", "approvalId"].includes(k)) || (value.approvalId !== undefined && !validToolId(value.approvalId))) throw new BadRequestException("INVALID_AGENT_DECISION");
+    const decision = value as unknown as AgentDecision;
+    return this.prisma.$transaction(async (tx: any) => {
+      const run = await this.loadAuthorizedRun(tx, runId, claims, "EXECUTE");
+      if (!["RUNNING", "COMPLETED", "AWAITING_APPROVAL"].includes(run.status)) return { authorization: blockedTool("RUN_NOT_ACTIVE"), executionBoundaryReached: false, executionPerformed: false };
+      // This conditional write holds the run row for the transaction. Cancellation,
+      // pause and concurrent decisions cannot be overwritten after authorization.
+      const locked = await tx.agentRun.updateMany({ where: { id: runId, status: run.status, planVersion: run.planVersion, updatedAt: run.updatedAt }, data: { updatedAt: new Date() } });
+      if (locked.count !== 1) throw new BadRequestException("RUN_STATE_CHANGED");
+      let authorization: AuthorizationDecision | undefined;
+      let status = "PAUSED", code: string = decision.type;
+      if (decision.type === "EXECUTE_TOOL" || decision.type === "REQUEST_APPROVAL") {
+        authorization = await this.authorization.authorize(runId, decision.toolRequest, claims, workspace,
+          { approvalId: decision.approvalId, forceApproval: decision.type === "REQUEST_APPROVAL" }, tx);
+        status = authorization.status === "APPROVAL_REQUIRED" ? "AWAITING_APPROVAL" : "PAUSED";
+        code = authorization.status === "AUTHORIZED" ? "EXECUTION_BOUNDARY_NOT_IMPLEMENTED" : authorization.code ?? "APPROVAL_REQUIRED";
+      } else if (decision.type === "STOP") {
+        status = "CANCELLED";
+        await this.cancelPending(tx, runId, claims);
+      } else if (decision.type === "COMPLETE") {
+        // Completion describes the control-plane job, never verification/execution.
+        const pending = await tx.agentApproval.count({ where: { agentRunId: runId, approvalType: "TOOL_AUTHORIZATION", status: "PENDING" } });
+        if (pending) throw new BadRequestException("APPROVAL_PENDING");
+        status = "COMPLETED";
+      }
+      const metadata = { phase: "5B", decision: decision.type, previousStatus: run.status, newStatus: status, code, executionPerformed: false };
+      await tx.agentRun.update({ where: { id: runId }, data: { status, failureReason: status === "PAUSED" ? code : null,
+        pausedAt: status === "PAUSED" ? new Date() : null, completedAt: status === "COMPLETED" ? new Date() : null, updatedAt: new Date() } });
+      await tx.agentRunEvent.create({ data: { agentRunId: runId, eventType: "STATUS_CHANGE", actor: claims.sub, payload: metadata } });
+      await this.audit.recordWithClaimsTx(tx, claims, { action: "AGENT_CONTROL_DECISION", resourceType: "AgentRun", resourceId: runId, details: metadata });
+      return { authorization, runStatus: status, executionBoundaryReached: authorization?.status === "AUTHORIZED", executionPerformed: false };
+    });
+  }
+  async decideApproval(runId: string, approvalId: string, claims: SessionClaims, body: unknown) {
+    if (!isRecord(body) || Object.keys(body).some(k => !["decision", "fingerprint"].includes(k))) throw new BadRequestException("INVALID_APPROVAL_DECISION");
+    return this.prisma.$transaction(async (tx: any) => {
+      // Use the same run lock ordering as tool proposals/cancellation.
+      const run = await tx.agentRun.findUnique({ where: { id: runId } });
+      if (!run) throw new NotFoundException("Agent run not found");
+      const locked = await tx.agentRun.updateMany({ where: { id: runId, status: run.status, updatedAt: run.updatedAt }, data: { updatedAt: new Date() } });
+      if (locked.count !== 1) throw new BadRequestException("RUN_STATE_CHANGED");
+      const status = await this.approvals.decide(tx, runId, approvalId, claims, body.decision, body.fingerprint);
+      return { approvalId, status, executionPerformed: false };
+    });
+  }
+  async cancelPending(tx: any, runId: string, claims: SessionClaims): Promise<void> {
+    const result = await tx.agentApproval.updateMany({ where: { agentRunId: runId, approvalType: "TOOL_AUTHORIZATION", status: { in: ["PENDING", "APPROVED"] } },
+      data: { status: "CANCELLED", decision: "CANCELLED", decidedBy: claims.sub, decidedAt: new Date() } });
+    if (result.count) {
+      const metadata = { phase: "5B", count: result.count, status: "CANCELLED" };
+      await tx.agentRunEvent.create({ data: { agentRunId: runId, eventType: "APPROVAL_CANCELLED", actor: claims.sub, payload: metadata } });
+      await this.audit.recordWithClaimsTx(tx, claims, { action: "APPROVAL_CANCELLED", resourceType: "AgentRun", resourceId: runId, details: metadata });
+    }
+  }
+  async suspendRecoveredBoundary(runId: string, claims: SessionClaims): Promise<boolean> {
+    const db: any = this.prisma;
+    const prior = await db.agentRunEvent.findFirst({ where: { agentRunId: runId, eventType: "TOOL_AUTHORIZATION_CHECKED" }, select: { id: true } });
+    if (!prior) return false;
+    await db.$transaction(async (tx: any) => {
+      const result = await tx.agentRun.updateMany({ where: { id: runId, status: { in: ["QUEUED", "PLANNING", "RUNNING"] } },
+        data: { status: "PAUSED", pausedAt: new Date(), failureReason: "CONTROL_PLANE_REAUTHORIZATION_REQUIRED", updatedAt: new Date() } });
+      if (result.count) await tx.agentRunEvent.create({ data: { agentRunId: runId, eventType: "STATUS_CHANGE", actor: claims.sub,
+        payload: { phase: "5B", newStatus: "PAUSED", code: "CONTROL_PLANE_REAUTHORIZATION_REQUIRED", executionPerformed: false } } });
+    });
+    return true;
+  }
+  private async loadAuthorizedRun(db: any, runId: string, claims: SessionClaims, action: "EXECUTE") {
+    const run = await db.agentRun.findUnique({ where: { id: runId }, include: { project: true } });
+    if (!run?.project) throw new NotFoundException("Agent run not found");
+    if (run.userId !== claims.sub) throw new BadRequestException("RUN_ACTOR_MISMATCH");
+    await this.resources.assertAuthorized(toolSubject(claims), action, { resourceType: "AgentRun", id: runId, projectId: run.projectId,
+      organizationId: run.project.organizationId ?? undefined, userId: run.userId });
+    return run;
+  }
+}
diff --git a/backend/src/agent-runtime/tools/tool-approval.service.ts b/backend/src/agent-runtime/tools/tool-approval.service.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/agent-runtime/tools/tool-approval.service.ts
@@ -0,0 +1,85 @@
+import { BadRequestException, Inject, Injectable, NotFoundException } from "@nestjs/common";
+import { ResourceAuthorizationService } from "../../auth/resource-authz.service";
+import { AuditService } from "../../audit/audit.service";
+import type { SessionClaims } from "../../auth/auth.dto";
+import { isRecord, toolDigest, toolSubject, type ToolApprovalBinding, type ToolApprovalStatus, type ToolBlockCode } from "./tool-contract";
+
+export const TOOL_APPROVAL_TTL_MS = 15 * 60 * 1000;
+export interface ToolApprovalEvaluation {
+  status: "NO_APPROVAL_REQUIRED" | "APPROVAL_REQUIRED" | "BLOCKED";
+  approvalId?: string;
+  code?: ToolBlockCode;
+  created?: boolean;
+}
+export function approvalBinding(value: unknown): ToolApprovalBinding | undefined {
+  if (!isRecord(value) || value.kind !== "TOOL_AUTHORIZATION" || value.version !== 1 || typeof value.fingerprint !== "string" || !/^[a-f0-9]{64}$/.test(value.fingerprint)) return;
+  return value as unknown as ToolApprovalBinding;
+}
+@Injectable()
+export class ToolApprovalService {
+  constructor(
+    @Inject(ResourceAuthorizationService) private readonly resources: ResourceAuthorizationService,
+    @Inject(AuditService) private readonly audit: AuditService
+  ) {}
+  async evaluate(db: any, binding: ToolApprovalBinding, required: boolean, suppliedId?: string): Promise<ToolApprovalEvaluation> {
+    const id = `toolapproval_${toolDigest([binding.runId, binding.requestId])}`;
+    if (suppliedId && suppliedId !== id) return { status: "BLOCKED", code: "APPROVAL_INVALID" };
+    let row = await db.agentApproval.findUnique({ where: { id } });
+    let created = false;
+    if (!row && suppliedId) return { status: "BLOCKED", code: "APPROVAL_INVALID" };
+    if (!row && !required) return { status: "NO_APPROVAL_REQUIRED" };
+    if (!row) {
+      // Run-level transaction serialization in AgentRuntime prevents duplicate
+      // requests; upsert also makes standalone authorization idempotent.
+      row = await db.agentApproval.upsert({ where: { id }, update: {}, create: {
+        id, agentRunId: binding.runId, approvalType: "TOOL_AUTHORIZATION", status: "PENDING",
+        requestedBy: binding.requestedBy, requiredRole: "Technical Reviewer",
+        revisedPlan: binding, dueAt: new Date(Date.now() + TOOL_APPROVAL_TTL_MS),
+        notes: "Approval applies only to the bound tool request. Execution remains unavailable."
+      } });
+      created = true;
+    }
+    const stored = approvalBinding(row.revisedPlan);
+    if (row.agentRunId !== binding.runId || row.approvalType !== "TOOL_AUTHORIZATION" || row.requestedBy !== binding.requestedBy ||
+      !stored || toolDigest(stored) !== toolDigest(binding)) return { status: "BLOCKED", code: "APPROVAL_INVALID" };
+    const expiry = row.dueAt && new Date(row.dueAt).getTime();
+    if (!expiry || !Number.isFinite(expiry) || expiry <= Date.now() || row.status === "EXPIRED") {
+      await db.agentApproval.updateMany({ where: { id, status: { in: ["PENDING", "APPROVED"] } }, data: { status: "EXPIRED", decision: "EXPIRED", decidedAt: new Date() } });
+      return { status: "BLOCKED", approvalId: id, code: "APPROVAL_EXPIRED" };
+    }
+    if (row.status === "APPROVED" && row.decision === "APPROVED" && row.decidedBy && row.decidedAt) return { status: "NO_APPROVAL_REQUIRED", approvalId: id };
+    if (row.status !== "PENDING") return { status: "BLOCKED", approvalId: id, code: "APPROVAL_INVALID" };
+    return { status: "APPROVAL_REQUIRED", approvalId: id, created };
+  }
+  /** Called only inside the runtime's transaction; identity is from AuthService. */
+  async decide(db: any, runId: string, id: string, claims: SessionClaims, decision: unknown, fingerprint: unknown): Promise<ToolApprovalStatus> {
+    if (!["APPROVED", "DENIED", "CANCELLED"].includes(String(decision)) || typeof fingerprint !== "string" || !/^[a-f0-9]{64}$/.test(fingerprint)) throw new BadRequestException("INVALID_APPROVAL_DECISION");
+    const row = await db.agentApproval.findUnique({ where: { id } });
+    if (!row || row.agentRunId !== runId || row.approvalType !== "TOOL_AUTHORIZATION") throw new NotFoundException("Tool approval not found");
+    const run = await db.agentRun.findUnique({ where: { id: runId }, include: { project: true, plans: { orderBy: { version: "desc" }, take: 1 } } });
+    if (!run?.project) throw new NotFoundException("Approval scope not found");
+    const subject = toolSubject(claims);
+    await this.resources.assertAuthorized(subject, "APPROVE", { resourceType: "Approval", id, projectId: run.projectId,
+      organizationId: run.project.organizationId ?? undefined, requiredRole: "Technical Reviewer" });
+    const binding = approvalBinding(row.revisedPlan);
+    const plan = run.plans?.[0];
+    if (!binding || binding.fingerprint !== fingerprint || binding.planId !== plan?.id || binding.planVersion !== plan?.version || binding.planDigest !== toolDigest(plan.steps)) throw new BadRequestException("APPROVAL_INVALID");
+    if (!["AWAITING_APPROVAL", "RUNNING", "COMPLETED"].includes(run.status)) throw new BadRequestException("RUN_NOT_ACTIVE");
+    const expiry = row.dueAt && new Date(row.dueAt).getTime();
+    const expired = !expiry || !Number.isFinite(expiry) || expiry <= Date.now();
+    const target = expired ? "EXPIRED" : decision as ToolApprovalStatus;
+    if (row.status !== "PENDING") {
+      if (row.status === target && row.decidedBy === claims.sub) return target;
+      throw new BadRequestException("APPROVAL_ALREADY_DECIDED");
+    }
+    const updated = await db.agentApproval.updateMany({ where: { id, status: "PENDING" }, data: { status: target, decision: target, decidedBy: claims.sub, decidedAt: new Date() } });
+    if (updated.count !== 1) throw new BadRequestException("APPROVAL_ALREADY_DECIDED");
+    const eventType = target === "APPROVED" ? "APPROVAL_GRANTED" : target === "EXPIRED" ? "APPROVAL_EXPIRED" : target === "CANCELLED" ? "APPROVAL_CANCELLED" : "APPROVAL_DENIED";
+    const metadata = { approvalId: id, requestId: binding.requestId, toolId: binding.toolId, planStepId: binding.planStepId, risk: binding.risk, status: target };
+    await db.agentRunEvent.create({ data: { agentRunId: runId, eventType, actor: claims.sub, payload: metadata } });
+    await this.audit.recordWithClaimsTx(db, claims, { action: eventType, resourceType: "AgentRun", resourceId: runId, details: metadata });
+    // Grant records a decision only. Reauthorization must still check permissions,
+    // current plan, scope and expiry; no scheduler or executor is called here.
+    return target;
+  }
+}
diff --git a/backend/src/agent-runtime/tools/tool-authorization.service.ts b/backend/src/agent-runtime/tools/tool-authorization.service.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/agent-runtime/tools/tool-authorization.service.ts
@@ -0,0 +1,102 @@
+import { Inject, Injectable, Optional } from "@nestjs/common";
+import { PrismaService } from "../../data-access/prisma.service";
+import { AuditService } from "../../audit/audit.service";
+import { ResourceAuthorizationService } from "../../auth/resource-authz.service";
+import type { SessionClaims } from "../../auth/auth.dto";
+import type { AgentPlanningResult } from "../understanding/agent-understanding.types";
+import { ToolRegistryService } from "./tool-registry.service";
+import { ToolPermissionService } from "./tool-permission.service";
+import { ToolScopeService } from "./tool-scope.service";
+import { ToolRiskService } from "./tool-risk.service";
+import { ToolApprovalService } from "./tool-approval.service";
+import { boundedToolJson, isRecord, matchesToolSchema, toolDigest, toolSubject, validToolId,
+  type AuthorizationDecision, type ToolRequest, type ToolScope, type TrustedToolWorkspace } from "./tool-contract";
+
+export interface ToolAuthorizationOptions { approvalId?: string; forceApproval?: boolean }
+export function blockedTool(code: NonNullable<AuthorizationDecision["code"]>): AuthorizationDecision { return { status: "BLOCKED", code, executionAllowed: false }; }
+
+/** The sole Phase 5B gate. No provider, skill, executor or runtime transport dependency. */
+@Injectable()
+export class ToolAuthorizationService {
+  constructor(
+    @Inject(ToolRegistryService) private readonly registry: ToolRegistryService,
+    @Inject(ToolScopeService) private readonly scopes: ToolScopeService,
+    @Inject(ToolPermissionService) private readonly permissions: ToolPermissionService,
+    @Inject(ToolRiskService) private readonly risks: ToolRiskService,
+    @Inject(ToolApprovalService) private readonly approvals: ToolApprovalService,
+    @Inject(ResourceAuthorizationService) private readonly resources: ResourceAuthorizationService,
+    @Inject(AuditService) private readonly audit: AuditService,
+    @Optional() @Inject(PrismaService) private readonly prisma?: PrismaService
+  ) {}
+  async authorize(runId: string, proposal: unknown, claims: SessionClaims, workspace?: TrustedToolWorkspace,
+    options: ToolAuthorizationOptions = {}, transaction?: any): Promise<AuthorizationDecision> {
+    const db = transaction ?? this.prisma;
+    if (!db || !validToolId(runId)) return blockedTool("POLICY_BLOCKED");
+    if (!transaction) return db.$transaction((tx: any) => this.authorize(runId, proposal, claims, workspace, options, tx));
+    const run = await db.agentRun.findUnique({ where: { id: runId }, include: { project: true, plans: { orderBy: { version: "desc" }, take: 1 } } });
+    if (!run?.project || run.userId !== claims.sub || !await this.resources.authorize(toolSubject(claims), "READ", {
+      resourceType: "AgentRun", id: runId, projectId: run.projectId, organizationId: run.project.organizationId ?? undefined, userId: run.userId
+    })) return blockedTool("PERMISSION_DENIED");
+    const locked = await db.agentRun.updateMany({ where: { id: runId, status: run.status, planVersion: run.planVersion, updatedAt: run.updatedAt }, data: { updatedAt: new Date() } });
+    if (locked.count !== 1) return blockedTool("RUN_NOT_ACTIVE");
+    const decision = await this.evaluate(db, run, proposal, claims, workspace, options);
+    const metadata = { phase: "5B", status: decision.status, code: decision.code ?? null, executionAllowed: false,
+      ...(decision.request ? { requestId: decision.request.id, toolId: decision.request.toolId, toolVersion: decision.request.toolVersion,
+        planStepId: decision.request.planStepId, workspaceId: decision.request.scope.workspaceId, risk: decision.request.risk } : {}),
+      ...(decision.approvalId ? { approvalId: decision.approvalId } : {}) };
+    await db.agentRunEvent.create({ data: { agentRunId: runId, eventType: "TOOL_REQUESTED", actor: claims.sub, payload: { ...metadata, status: "PROPOSED" } } });
+    await db.agentRunEvent.create({ data: { agentRunId: runId, eventType: "TOOL_AUTHORIZATION_CHECKED", actor: claims.sub, payload: metadata } });
+    if (decision.status !== "AUTHORIZED") await db.agentRunEvent.create({ data: { agentRunId: runId,
+      eventType: decision.status === "BLOCKED" ? "TOOL_BLOCKED" : "APPROVAL_REQUESTED", actor: claims.sub, payload: metadata } });
+    await this.audit.recordWithClaimsTx(db, claims, { action: "TOOL_AUTHORIZATION_CHECKED", resourceType: "AgentRun", resourceId: runId,
+      result: decision.status === "BLOCKED" ? "DENIED" : "SUCCESS", details: metadata });
+    return decision;
+  }
+  private async evaluate(db: any, run: any, proposal: unknown, claims: SessionClaims, workspace: TrustedToolWorkspace | undefined, options: ToolAuthorizationOptions): Promise<AuthorizationDecision> {
+    if (!boundedToolJson(proposal) || !isRecord(proposal)) return blockedTool("INVALID_INPUT");
+    const keys = ["id", "toolId", "toolVersion", "input", "purpose", "scope", "requestedBy", "runId", "planStepId", "risk", "requiresApproval"];
+    if (Object.keys(proposal).some(k => !keys.includes(k)) || ![proposal.id, proposal.toolId, proposal.toolVersion, proposal.runId, proposal.planStepId].every(validToolId) ||
+      proposal.requestedBy !== "AGENT" || proposal.runId !== run.id || typeof proposal.purpose !== "string" || !proposal.purpose.trim() || proposal.purpose.length > 512 ||
+      !isRecord(proposal.input) || !isRecord(proposal.scope) || Object.keys(proposal.scope).some(k => !["workspaceId", "paths"].includes(k)) ||
+      !validToolId(proposal.scope.workspaceId) || !Array.isArray(proposal.scope.paths) || !proposal.scope.paths.length || proposal.scope.paths.length > 32 ||
+      proposal.scope.paths.some(p => typeof p !== "string") || (proposal.risk !== undefined && !["LOW", "MEDIUM", "HIGH"].includes(String(proposal.risk))) ||
+      (proposal.requiresApproval !== undefined && typeof proposal.requiresApproval !== "boolean")) return blockedTool("INVALID_INPUT");
+    let tool;
+    try { tool = this.registry.resolve(proposal.toolId as string, proposal.toolVersion as string); } catch { return blockedTool("INVALID_TOOL"); }
+    if (!matchesToolSchema(proposal.input, tool.inputSchema)) return blockedTool("INVALID_INPUT");
+    if (!["RUNNING", "COMPLETED", "AWAITING_APPROVAL"].includes(run.status)) return blockedTool("RUN_NOT_ACTIVE");
+    const plan = run.plans?.[0];
+    const work = Array.isArray(plan?.steps) && plan.steps.length === 1 ? plan.steps[0] : undefined;
+    const planning = work?.planningOnly === true && work.skillId === "" ? work.parameters?.planning as AgentPlanningResult | undefined : undefined;
+    const step = Array.isArray(planning?.plan?.steps) ? planning.plan.steps.find(s => s?.id === proposal.planStepId) : undefined;
+    if (!plan || plan.version !== run.planVersion || plan.status !== "PLAN_READY" || planning?.version !== 1 || planning.plan.readiness !== "PLAN_READY" ||
+      !planning.plan.validation?.valid || !Array.isArray(planning.plan.constraints) || planning.understanding?.readiness !== "UNDERSTANDING_READY" || !step || step.status !== "PLANNED") return blockedTool("INVALID_PLAN_STEP");
+    const scoped = this.scopes.validate(tool, proposal.input, proposal.scope as unknown as ToolScope, run.projectId, workspace);
+    if (!scoped.allowed) return blockedTool(scoped.code);
+    const permissions = await this.permissions.check(toolSubject(claims), tool.requiredPermissions, scoped.workspace, scoped.scope, run.project.organizationId ?? undefined);
+    if (permissions.some(p => !p.allowed)) return { ...blockedTool("PERMISSION_DENIED"), permissions };
+    const risk = this.risks.classify(tool);
+    const mutation = tool.requiredPermissions.some(p => !["filesystem.read", "git.read"].includes(p));
+    const destructive = tool.requiredPermissions.includes("filesystem.delete");
+    const execution = tool.category === "TERMINAL";
+    const rules = planning.plan.constraints.map(c => c.rule);
+    if (rules.includes("UNRESOLVED") || (mutation && rules.includes("NO_WRITE")) || (execution && rules.includes("NO_EXECUTE")) ||
+      (destructive && rules.includes("NO_DESTRUCTIVE")) || (mutation && step.effect === "READ_ONLY") || (execution && step.effect !== "EXECUTE") ||
+      (destructive && step.effect !== "DESTRUCTIVE" && tool.id !== "filesystem.move") ||
+      (mutation && !execution && !["WRITE", "DESTRUCTIVE"].includes(step.effect))) return blockedTool("POLICY_BLOCKED");
+    const requiresApproval = mutation || risk !== "LOW" || options.forceApproval === true || !!options.approvalId;
+    const request: ToolRequest = { id: proposal.id as string, toolId: tool.id, toolVersion: tool.version,
+      input: structuredClone(proposal.input), purpose: proposal.purpose, scope: scoped.scope, requestedBy: "AGENT", runId: run.id,
+      planStepId: step.id, risk, requiresApproval };
+    const planDigest = toolDigest(plan.steps);
+    const { requiresApproval: _approval, ...operation } = request;
+    const binding = { kind: "TOOL_AUTHORIZATION" as const, version: 1 as const,
+      fingerprint: toolDigest({ operation, actorId: claims.sub, planDigest, workspace: scoped.workspace, pathBindingHash: scoped.pathBindingHash, policy: "phase5b-v1" }),
+      requestId: request.id, toolId: tool.id, toolVersion: tool.version, runId: run.id, planId: plan.id, planVersion: plan.version,
+      planDigest, planStepId: step.id, risk, scope: scoped.scope, requestedBy: claims.sub };
+    const approval = await this.approvals.evaluate(db, binding, requiresApproval, options.approvalId);
+    request.requiresApproval = requiresApproval || !!approval.approvalId;
+    return { status: approval.status === "NO_APPROVAL_REQUIRED" ? "AUTHORIZED" : approval.status, code: approval.code,
+      request, permissions, approvalId: approval.approvalId, executionAllowed: false };
+  }
+}
