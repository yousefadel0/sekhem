NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://localhost:5432/sekhem_product_dev?schema=public
SEKHEM_DATA_SOURCE=memory
# Exact browser origins allowed to call the Backend with credentials.
SEKHEM_CORS_ALLOWED_ORIGINS=https://app.sekhem-ai.com
# Required for persisted provider and repository credentials. Use a 32-byte key
# encoded as 64 hexadecimal characters or base64; never commit its value.
SEKHEM_CONFIG_MASTER_KEY=
# Optional previous key during a rotation window; remove it after saved
# credentials have been replaced through the Admin UI under the new key.
SEKHEM_CONFIG_MASTER_KEY_PREVIOUS=
